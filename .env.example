# =====================================================================
# RAG Application — Environment Configuration
# Copy this file to `.env` and fill in the values you need.
# =====================================================================

# ---------------------------------------------------------------------
# Provider selection
# Choose which provider powers the LLM and the embeddings.
#   LLM_PROVIDER:       openai | gemini | ollama
#   EMBEDDING_PROVIDER: openai | gemini | huggingface | ollama
# These let you switch providers WITHOUT touching any code.
# Tip: set both to `gemini` to run entirely on a single GOOGLE_API_KEY.
# ---------------------------------------------------------------------
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# ---------------------------------------------------------------------
# API keys
# Only required for openai / gemini. Ollama is local and needs NO key.
# ---------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------
# Ollama (local). Start it with `ollama serve` and pull your models:
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------
# Models
#   LLM_MODEL examples:
#     ollama -> llama3.1, llama3.2, mistral, qwen2.5
#     openai -> gpt-4o-mini, gpt-4o
#     gemini -> gemini-flash-latest, gemini-pro-latest, gemini-2.5-flash-lite
#   EMBEDDING_MODEL examples:
#     gemini      -> models/gemini-embedding-001
#     ollama      -> nomic-embed-text, mxbai-embed-large
#     openai      -> text-embedding-3-small, text-embedding-3-large
#     huggingface -> sentence-transformers/all-MiniLM-L6-v2
# ---------------------------------------------------------------------
LLM_MODEL=gemini-flash-latest
EMBEDDING_MODEL=models/gemini-embedding-001

# ---------------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------------
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ---------------------------------------------------------------------
# Ingestion / chunking
# ---------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PDF_UPLOAD_DIR=./data/pdfs

# ---------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------
# LLM generation
# ---------------------------------------------------------------------
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
